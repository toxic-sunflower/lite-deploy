# keys, passwords and files with secrets are never committed
*.pem
*.key
id_*
*.env
*.env.*
.env*
secrets*

# Go build output
/lite-deploy
*.test
*.out
# the sources of the internal/secrets package are code, not secrets
!/internal/secrets/
!/internal/secrets/**

# the release signing private key
minisign.key

# site build output
/_site

# Python bytecode
__pycache__/
*.pyc
