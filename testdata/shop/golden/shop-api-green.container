[Unit]
Description=shop api (slot green)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=shop-api-green
Image=localhost/shop-api:green
PublishPort=127.0.0.1:18082:8080
EnvironmentFile=%h/.config/lite-deploy/env/api.env
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=512
PodmanArgs=--memory=768m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
