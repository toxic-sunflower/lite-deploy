[Unit]
Description=shop api (slot blue)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=shop-api-blue
Image=localhost/shop-api:blue
PublishPort=127.0.0.1:18081:8080
EnvironmentFile=%h/.config/lite-deploy/env/api.env
Volume=/var/run/postgresql:/var/run/postgresql
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=512
PodmanArgs=--memory=768m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
