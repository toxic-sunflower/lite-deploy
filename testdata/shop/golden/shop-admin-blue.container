[Unit]
Description=shop admin (slot blue)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=shop-admin-blue
Image=localhost/shop-admin:blue
PublishPort=127.0.0.1:18091:8080
EnvironmentFile=%h/.config/lite-deploy/env/admin.env
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=256
PodmanArgs=--memory=384m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
