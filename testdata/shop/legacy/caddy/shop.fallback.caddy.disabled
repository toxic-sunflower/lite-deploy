# A FALLBACK in case Cloudflare or the tunnel fails. Normally off: the .disabled extension,
# Caddy does not read such files (the main Caddyfile includes only /etc/caddy/conf.d/*.caddy).
# Turning it on and back off is described in the README.md of this folder, the section "If Cloudflare is unavailable".
#
# The site opens directly on 443 with an ordinary public certificate (Let's Encrypt, Caddy obtains it itself).
# While it is on, bypassing Cloudflare cannot be avoided: the site is reachable by the server IP. Keep it on only during an outage.
shop.example.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# The deploy script sets X-Forwarded-For in the upstream from CF-Connecting-IP. Without Cloudflare that header does not exist, and a header
	# sent by the client must not be passed on (address spoofing), so we put in the real address ourselves.
	request_header CF-Connecting-IP {remote_host}

	@upload path /api/vault/upload
	handle @upload {
		request_body {
			max_size 1500MB
		}
		import /etc/caddy/upstreams/shop.caddy
	}

	handle {
		request_body {
			max_size 5MB
		}
		import /etc/caddy/upstreams/shop.caddy
	}

	log {
		output file /var/log/caddy/shop.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
