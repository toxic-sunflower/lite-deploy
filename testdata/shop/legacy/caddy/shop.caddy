# The the example project site. Installed as /etc/caddy/conf.d/shop.caddy.
# Traffic arrives from the cloudflared tunnel (Cloudflare → tunnel → this address). The site listens ONLY on 127.0.0.1:18080,
# it is not exposed to the outside (on 443): it cannot be reached around Cloudflare by the server IP.
# The tunnel forwards the original site name in the Host header, so the site address is given by name.
# A fallback in case Cloudflare fails sits next to it: shop.fallback.caddy.disabled (turned on by hand).
# Where traffic goes (blue or green) is decided by the file /etc/caddy/upstreams/shop.caddy, which the deploy script changes.
http://shop.example.com:18080 {
	bind 127.0.0.1

	encode zstd gzip

	header {
		# HTTPS only. includeSubDomains and preload are not enabled: other sites may live on the domain
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# There is deliberately NO X-Frame-Options and no own Content-Security-Policy: the application is shown inside shop,
	# and the permission for that (frame-ancestors) is set by the application itself.

	# File uploads to the Vault: the free Cloudflare plan passes at most 100 MB of request body.
	@upload path /api/vault/upload
	handle @upload {
		request_body {
			max_size 100MB
		}
		import /etc/caddy/upstreams/shop.caddy
	}

	# Everything else: small requests
	handle {
		request_body {
			max_size 5MB
		}
		import /etc/caddy/upstreams/shop.caddy
	}

	log {
		output file /var/log/caddy/shop.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
