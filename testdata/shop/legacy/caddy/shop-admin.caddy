# The the example project admin site. Installed as /etc/caddy/conf.d/shop-admin.caddy.
# Like the main site, it listens on 127.0.0.1 only (port 18090), and the cloudflared tunnel talks to it. In front of the admin there is
# Cloudflare Access (login by email), then the login of the admin itself.
# Where traffic goes (blue or green) is decided by the file /etc/caddy/upstreams/shop-admin.caddy, which the deploy script changes.
http://admin.shop.example.com:18090 {
	bind 127.0.0.1

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	# Blazor Server uses WebSocket: reverse_proxy passes it through by itself. Request bodies are small.
	request_body {
		max_size 5MB
	}
	import /etc/caddy/upstreams/shop-admin.caddy

	log {
		output file /var/log/caddy/shop-admin.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
