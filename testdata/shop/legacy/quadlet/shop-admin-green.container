# The green slot of the platform admin. It lives in ~/.config/containers/systemd/ of the user shop.
# The image localhost/shop-admin:green is created by the deploy script (podman tag). The port is not published outside: only
# Caddy (the admin site on 127.0.0.1:18090) talks to it, and the cloudflared tunnel talks to Caddy; login is protected by Cloudflare Access and the admin login.
[Unit]
Description=the example project admin (slot green)
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=shop-admin-green
Image=localhost/shop-admin:green
PublishPort=127.0.0.1:18092:8080
# the database connection string and the admin login (Admin__Username, Admin__Password), the file is created by hand, mode 600
EnvironmentFile=%h/.config/shop/admin.env
Environment=ASPNETCORE_ENVIRONMENT=Production
Volume=/var/run/postgresql:/var/run/postgresql
ReadOnly=true
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=ALL
PidsLimit=256
Memory=384m

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
