http://fanvue-games.prozorov.site:18080 {
	bind 127.0.0.1

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	@route1 path /api/vault/upload
	handle @route1 {
		request_body {
			max_size 100MB
		}
		import /etc/caddy/upstreams/fanvue-games-main.caddy
	}

	handle {
		request_body {
			max_size 5MB
		}
		import /etc/caddy/upstreams/fanvue-games-main.caddy
	}

	log {
		output file /var/log/caddy/fanvue-games-main.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
