{
  "schema": "lite-deploy/project/v1",
  "name": "demo-app",
  "description": "A test project for checking S4 in WSL (no registry and no CI key)",
  "services": {
    "web": {
      "image": "localhost/demo-app-web",
      "container_port": 8080,
      "limits": { "memory": "256m", "pids": 128 },
      "env": { "APP_ENV": "test" },
      "secrets": { "APP_SECRET": "secret://app_secret", "DATABASE_URL": "secret://database_url" },
      "sockets": ["/var/run/postgresql"]
    }
  },
  "sites": [
    { "name": "main", "host": "demo.example.com", "service": "web", "trusted_proxy": "none", "max_body": "5MB" }
  ]
}
