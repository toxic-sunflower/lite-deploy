#!/usr/bin/env bash
# Привратник ключа деплоя. Ставится на сервер ОДИН РАЗ вручную и меняется только вручную: именно он решает,
# что этот ключ вообще может делать (в authorized_keys: command="/home/fanvue-games/bin/fanvue-ssh-gate",restrict ...).
# Оболочки у ключа нет. Разрешено три вещи:
#   deploy <полный хэш>   запустить деплой этой версии
#   rollback              откат на прошлый слот
#   status                состояние
# Скрипт ~/bin/fanvue-deploy и юниты Quadlet тоже ставятся вручную: ключ не присылает ничего, что потом выполнится на сервере.
set -euo pipefail

cmd=${SSH_ORIGINAL_COMMAND:-}
bin="$HOME/bin"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

die() { echo "ОШИБКА: $*" >&2; exit 2; }

case $cmd in
  "deploy "*)
    sha=${cmd#deploy }
    [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "нужен полный хэш коммита"
    exec "$bin/fanvue-deploy" deploy "$sha"
    ;;
  rollback) exec "$bin/fanvue-deploy" rollback ;;
  status) exec "$bin/fanvue-deploy" status ;;
  *) die "команда не разрешена (можно: deploy <хэш>, rollback, status)" ;;
esac
