#!/usr/bin/env bash
# Blue-green деплой FanVue Games. Работает на сервере от пользователя проекта (fanvue-games).
#
#   fanvue-deploy deploy <полный хэш коммита>   поднять эту версию в свободном слоте и переключить на неё трафик
#   fanvue-deploy rollback                      переключить трафик обратно на прошлый слот (он ещё работает)
#   fanvue-deploy status                        показать активный слот и версии обоих
#
# Слоты blue и green это две копии каждой части (сервис и админка) на разных локальных портах. Caddy смотрит в один
# из слотов через файл upstream своей части. Новая версия сначала поднимается в свободных слотах и проверяется
# (/health/ready обеих частей отвечает версией этого коммита), и только потом Caddy переключается на неё. Если проверка
# не прошла, трафик остаётся на старой версии. Сервис и админка переключаются вместе, одним коммитом и одним состоянием.
set -euo pipefail

CONF="${FANVUE_CONF:-$HOME/.config/fanvue-games/deploy.conf}"
[[ -r $CONF ]] || { echo "ОШИБКА: нет файла настроек $CONF" >&2; exit 1; }
# shellcheck disable=SC1090
source "$CONF"   # IMAGE_API=ghcr.io/<владелец>/fanvue-games-api, IMAGE_ADMIN=ghcr.io/<владелец>/fanvue-games-admin
: "${IMAGE_API:?не задан IMAGE_API}" "${IMAGE_ADMIN:?не задан IMAGE_ADMIN}"

UPSTREAM_API="${UPSTREAM_API:-/etc/caddy/upstreams/fanvue-games.caddy}"
UPSTREAM_ADMIN="${UPSTREAM_ADMIN:-/etc/caddy/upstreams/fanvue-games-admin.caddy}"
RELOAD_CMD="${RELOAD_CMD:-sudo -n /usr/bin/systemctl reload caddy}"
STATE_DIR="${STATE_DIR:-$HOME/.local/state/fanvue-games}"
READY_TRIES="${READY_TRIES:-45}"   # по 2 секунды
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$STATE_DIR"

log() { printf '[%s] %s\n' "$(date -u +%H:%M:%S)" "$*"; }
die() { printf 'ОШИБКА: %s\n' "$*" >&2; exit 1; }

parts=(api admin)
port_of() {   # часть, слот
  case $1:$2 in
    api:blue) echo 18081 ;; api:green) echo 18082 ;;
    admin:blue) echo 18091 ;; admin:green) echo 18092 ;;
    *) die "неизвестная часть или слот: $1 $2" ;;
  esac
}
upstream_of() { case $1 in api) echo "$UPSTREAM_API" ;; admin) echo "$UPSTREAM_ADMIN" ;; esac; }
image_of() { case $1 in api) echo "$IMAGE_API" ;; admin) echo "$IMAGE_ADMIN" ;; esac; }
other() { [[ $1 == blue ]] && echo green || echo blue; }
active() { cat "$STATE_DIR/active" 2>/dev/null || echo none; }
unit_of() { echo "fanvue-games-$1-$2"; }   # часть, слот

# версия, которую слот части отдаёт на /health/ready (пусто, если слот не готов)
version_of() {
  curl -fsS --max-time 3 "http://127.0.0.1:$(port_of "$1" "$2")/health/ready" 2>/dev/null \
    | sed -n 's/.*"version":"\([^"]*\)".*/\1/p'
}

wait_ready() {   # слот, хэш: ждём обе части
  local slot=$1 want=$2 part i got
  for part in "${parts[@]}"; do
    for ((i = 1; i <= READY_TRIES; i++)); do
      got=$(version_of "$part" "$slot" || true)
      [[ $got == "$want" ]] && continue 2
      sleep 2
    done
    log "часть $part в слоте $slot не стала готовой (ответ: ${got:-нет})"
    return 1
  done
}

# Caddy перечитывает файлы upstream. Прежнее содержимое возвращается, если Caddy не принял новую конфигурацию.
switch_to() {
  local slot=$1 part file tmp
  local -a backups=() files=()
  for part in "${parts[@]}"; do
    file=$(upstream_of "$part")
    tmp=$(mktemp "$file.XXXXXX")
    backups+=("$(mktemp)")
    cp "$file" "${backups[-1]}" 2>/dev/null || : > "${backups[-1]}"
    printf 'reverse_proxy 127.0.0.1:%s {\n\theader_up X-Forwarded-For {header.CF-Connecting-IP}\n\theader_up X-Forwarded-Proto https\n}\n' \
      "$(port_of "$part" "$slot")" > "$tmp"
    chmod 644 "$tmp"
    mv "$tmp" "$file"
    files+=("$file")
  done
  if ! $RELOAD_CMD; then
    local i
    for i in "${!files[@]}"; do cp "${backups[$i]}" "${files[$i]}"; done
    $RELOAD_CMD || true
    rm -f "${backups[@]}"
    die "Caddy не принял переключение, возвращён прежний слот"
  fi
  rm -f "${backups[@]}"
}

record() { printf '%s %s\n' "$(date -u +%FT%TZ)" "$*" >> "$STATE_DIR/history.log"; }

cmd_deploy() {
  local sha=${1:-} cur idle part
  [[ $sha =~ ^[0-9a-f]{40}$ ]] || die "нужен полный хэш коммита (40 символов)"
  cur=$(active)
  if [[ $cur == none ]]; then idle=blue; else idle=$(other "$cur"); fi
  log "версия $sha, активный слот: $cur, поднимаем в: $idle"

  log "скачиваем образы"
  for part in "${parts[@]}"; do
    podman pull -q "$(image_of "$part"):$sha" > /dev/null
    podman tag "$(image_of "$part"):$sha" "localhost/fanvue-games-$part:$idle"
  done

  log "запускаем слот $idle"
  for part in "${parts[@]}"; do
    systemctl --user restart "$(unit_of "$part" "$idle").service"
  done

  if ! wait_ready "$idle" "$sha"; then
    log "новая версия не стала готовой за $((READY_TRIES * 2)) с, трафик остаётся на слоте $cur"
    for part in "${parts[@]}"; do
      podman logs --tail 40 "$(unit_of "$part" "$idle")" 2>&1 || true
      systemctl --user stop "$(unit_of "$part" "$idle").service" || true
    done
    record "deploy-failed $sha slot=$idle"
    exit 1
  fi

  log "слот $idle готов, переключаем трафик"
  switch_to "$idle"
  echo "$idle" > "$STATE_DIR/active"
  record "deploy $sha slot=$idle previous=$cur"

  log "готово: активен слот $idle ($sha); прежний слот $cur оставлен для отката"
}

cmd_rollback() {
  local cur prev part v
  cur=$(active)
  [[ $cur != none ]] || die "ещё ничего не выкатывали"
  prev=$(other "$cur")
  for part in "${parts[@]}"; do
    v=$(version_of "$part" "$prev" || true)
    [[ -n $v ]] || die "прошлый слот ($prev, часть $part) не отвечает: откатываться некуда, выкатите нужную версию заново"
  done
  v=$(version_of api "$prev")
  log "откат: слот $cur -> слот $prev (версия $v)"
  switch_to "$prev"
  echo "$prev" > "$STATE_DIR/active"
  record "rollback to=$prev version=$v from=$cur"
  log "готово: активен слот $prev ($v)"
}

cmd_status() {
  local cur slot part v
  cur=$(active)
  echo "активный слот: $cur"
  for slot in blue green; do
    for part in "${parts[@]}"; do
      v=$(version_of "$part" "$slot" || true)
      printf '  %-5s %-6s порт %s  версия: %s\n' "$slot" "$part" "$(port_of "$part" "$slot")" "${v:-не отвечает}"
    done
  done
  [[ -r $STATE_DIR/history.log ]] && { echo "последние события:"; tail -5 "$STATE_DIR/history.log" | sed 's/^/  /'; }
  return 0
}

case ${1:-} in
  deploy) shift; cmd_deploy "$@" ;;
  rollback) cmd_rollback ;;
  status) cmd_status ;;
  *) die "команды: deploy <хэш> | rollback | status" ;;
esac
