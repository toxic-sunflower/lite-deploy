{
  "$id": "lite-deploy/project/v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adopt": {
      "description": "take over a project that was set up by hand",
      "type": "boolean"
    },
    "deploy_key": {
      "additionalProperties": false,
      "properties": {
        "public_key": {
          "description": "a single ed25519 key without options",
          "pattern": "^ssh-ed25519 AAAAC3NzaC1lZDI1NTE5[A-Za-z0-9+/]{48}( [^\\r\\n]{1,100})?$",
          "type": "string"
        }
      },
      "required": [
        "public_key"
      ],
      "type": "object"
    },
    "description": {
      "maxLength": 200,
      "type": "string"
    },
    "name": {
      "description": "project name; the same as the system user name",
      "pattern": "^[a-z][a-z0-9-]{1,30}$",
      "type": "string"
    },
    "registry": {
      "additionalProperties": false,
      "properties": {
        "host": {
          "maxLength": 255,
          "pattern": "^[a-z0-9.-]+(:[0-9]{2,5})?$",
          "type": "string"
        },
        "token_secret": {
          "description": "secret://name reference; a read-only token",
          "pattern": "^secret://(shared/)?[a-z][a-z0-9_]{1,63}$",
          "type": "string"
        },
        "username": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}$",
          "type": "string"
        }
      },
      "required": [
        "host",
        "username",
        "token_secret"
      ],
      "type": "object"
    },
    "schema": {
      "description": "schema version",
      "enum": [
        "lite-deploy/project/v1",
        "lite-deploy/project/v2"
      ],
      "type": "string"
    },
    "services": {
      "additionalProperties": {
        "additionalProperties": false,
        "properties": {
          "container_port": {
            "description": "for quadlet: the application port inside the container",
            "maximum": 65535,
            "minimum": 1,
            "type": "integer"
          },
          "data": {
            "description": "persistent directories of the component (shared by the blue and green slots, they survive deploys): a unit sees them in LITE_DATA_\u003cNAME\u003e variables, a container in /data/\u003cname\u003e",
            "items": {
              "type": "string"
            },
            "maxItems": 8,
            "type": "array"
          },
          "env": {
            "additionalProperties": {
              "maxLength": 1024,
              "pattern": "^[^\\r\\n]*$",
              "type": "string"
            },
            "maxProperties": 128,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "type": "object"
          },
          "exec": {
            "description": "for unit: start command (program path and arguments); the port is passed in the PORT variable",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array"
          },
          "health": {
            "additionalProperties": false,
            "properties": {
              "path": {
                "maxLength": 256,
                "pattern": "^/[^\\s]*$",
                "type": "string"
              },
              "timeout_seconds": {
                "maximum": 600,
                "minimum": 5,
                "type": "integer"
              },
              "version_field": {
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
                "type": "string"
              }
            },
            "type": "object"
          },
          "host_ports": {
            "description": "ports of the blue and green slots",
            "items": {
              "maximum": 18999,
              "minimum": 18000,
              "type": "integer"
            },
            "maxItems": 2,
            "minItems": 2,
            "type": "array"
          },
          "image": {
            "description": "image without a tag",
            "maxLength": 255,
            "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*(:[0-9]+)?(/[a-z0-9]+([._-][a-z0-9]+)*)+$",
            "type": "string"
          },
          "kind": {
            "description": "how it runs: quadlet (container, the default) or unit (a process on the host)",
            "enum": [
              "quadlet",
              "unit"
            ],
            "type": "string"
          },
          "limits": {
            "additionalProperties": false,
            "properties": {
              "memory": {
                "pattern": "^[1-9][0-9]*[mg]$",
                "type": "string"
              },
              "pids": {
                "maximum": 4096,
                "minimum": 16,
                "type": "integer"
              }
            },
            "type": "object"
          },
          "release": {
            "additionalProperties": false,
            "description": "for unit: where the release comes from",
            "properties": {
              "minisign_key": {
                "description": "minisign public key that CI signs the archive with; the signature sits next to it: the archive URL plus .minisig",
                "pattern": "^RW[A-Za-z0-9+/]{54}$",
                "type": "string"
              },
              "token_secret": {
                "description": "secret://name reference; the token is sent as Authorization: Bearer",
                "pattern": "^secret://(shared/)?[a-z][a-z0-9_]{1,63}$",
                "type": "string"
              },
              "url": {
                "description": "URL of the tar.gz archive; {sha} is replaced with the hash of the version being deployed",
                "maxLength": 512,
                "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{2,5})?/[^\\s{}]*\\{sha\\}[^\\s{}]*$",
                "type": "string"
              }
            },
            "required": [
              "url",
              "minisign_key"
            ],
            "type": "object"
          },
          "secrets": {
            "additionalProperties": {
              "pattern": "^secret://(shared/)?[a-z][a-z0-9_]{1,63}$",
              "type": "string"
            },
            "maxProperties": 128,
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            },
            "type": "object"
          },
          "sockets": {
            "description": "for quadlet: directories of sockets on the host that the container may use (under /run or /var/run), for example /var/run/postgresql for a database on this server",
            "items": {
              "type": "string"
            },
            "maxItems": 4,
            "type": "array"
          },
          "stop": {
            "description": "for unit: stop command (ExecStop), for example podman compose down",
            "items": {
              "type": "string"
            },
            "maxItems": 32,
            "minItems": 1,
            "type": "array"
          }
        },
        "type": "object"
      },
      "maxProperties": 8,
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,15}$"
      },
      "type": "object"
    },
    "sites": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "fallback_auth": {
            "additionalProperties": false,
            "properties": {
              "paths": {
                "description": "paths to protect, for example /admin* ; empty: the whole site",
                "items": {
                  "type": "string"
                },
                "maxItems": 8,
                "type": "array"
              },
              "users": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "pattern": "^[a-z][a-z0-9._-]{0,30}$",
                      "type": "string"
                    },
                    "password_hash": {
                      "pattern": "^\\$2[aby]\\$[0-9]{2}\\$[./A-Za-z0-9]{53}$",
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "password_hash"
                  ],
                  "type": "object"
                },
                "maxItems": 8,
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "users"
            ],
            "type": "object"
          },
          "host": {
            "maxLength": 253,
            "pattern": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,63}$",
            "type": "string"
          },
          "listen_port": {
            "description": "Caddy port on 127.0.0.1; if omitted, a free one is chosen",
            "maximum": 18999,
            "minimum": 18000,
            "type": "integer"
          },
          "max_body": {
            "pattern": "^[1-9][0-9]*(KB|MB)$",
            "type": "string"
          },
          "name": {
            "pattern": "^[a-z][a-z0-9-]{0,15}$",
            "type": "string"
          },
          "publish": {
            "description": "tunnel: Caddy listens on 127.0.0.1 only (Cloudflare Tunnel); direct: Caddy also serves the host on 80/443 with its own TLS certificate",
            "enum": [
              "tunnel",
              "direct"
            ],
            "type": "string"
          },
          "routes": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "max_body": {
                  "pattern": "^[1-9][0-9]*(KB|MB)$",
                  "type": "string"
                },
                "path": {
                  "maxLength": 256,
                  "pattern": "^/[^\\s{}]*$",
                  "type": "string"
                }
              },
              "required": [
                "path",
                "max_body"
              ],
              "type": "object"
            },
            "maxItems": 16,
            "type": "array"
          },
          "service": {
            "pattern": "^[a-z][a-z0-9-]{0,15}$",
            "type": "string"
          },
          "trusted_proxy": {
            "enum": [
              "cloudflare",
              "none"
            ],
            "type": "string"
          },
          "tunnel": {
            "description": "the Cloudflare Tunnel (a name from lite cloudflare status) this site is reached through; default: the default tunnel",
            "pattern": "^[a-z][a-z0-9-]{0,20}$",
            "type": "string"
          }
        },
        "required": [
          "name",
          "host",
          "service"
        ],
        "type": "object"
      },
      "maxItems": 8,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "schema",
    "name",
    "services",
    "sites"
  ],
  "title": "lite-deploy project description",
  "type": "object"
}
